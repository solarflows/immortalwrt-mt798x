#!/bin/sh /etc/rc.common
# Copyright (C) 2006 OpenWrt.org

START=50
USE_PROCD=1

# 逐个设备的规则设置
parse_device() {
	local cfg="$1"

	local enabled
	config_get_bool enabled "$cfg" "enabled" "1"
	[ "$enabled" -eq "1" ] || return 1

	local ip download upload comment mac interfacename
	config_get ip "$cfg" ip
	config_get download "$cfg" "download"
	config_get upload "$cfg" "upload"
	config_get comment "$cfg" "comment"
	config_get mac "$cfg" "mac"
	config_get interfacename "$cfg" "interfacename"

    logger -t eqos "Processing device: IP=$ip, MAC=$mac, DL=${download}Kbps, UL=${upload}Kbps, Interface=$interfacename"
	eqos add "$ip" "$download" "$upload" "$comment" "$mac" "$interfacename"
}

# 启动整个服务
start_service() {
	config_load "eqos"

	local enabled
	config_get_bool enabled "config" "enabled" "0"
	[ "$enabled" -eq "1" ] || return 1

	local download upload comment smarthqos interface ipv6enabled
	config_get download "config" "download"
	config_get upload "config" "upload"
	config_get comment "config" "comment"
	config_get smarthqos "config" "smarthqos"
	config_get interface "config" "interface"
	config_get_bool ipv6enabled "config" "ipv6enabled" "0"

	# 设置全局限速
	logger -t eqos "Starting EQoS service - Download: ${download}Mbps, Upload: ${upload}Mbps, SmartQoS: $smarthqos, IPv6: $ipv6enabled"
	eqos start "$download" "$upload" "$comment"

	# IPv6独立配置
	if [ "$ipv6enabled" -eq "1" ]; then
		# 为ipv6新建并且清空eqos链
		ebtables -t nat -N eqos
		ebtables -t nat -F eqos
		ip6tables -t mangle -N eqos
		ip6tables -t mangle -F eqos

		# 删除现存调用到POSTROUTING链的eqos链,并且重新调用
		ebtables -t nat -D POSTROUTING -j eqos -p ipv6
		ebtables -t nat -A POSTROUTING -j eqos -p ipv6
		ip6tables -t mangle -D FORWARD -j eqos
		ip6tables -t mangle -A FORWARD -j eqos
	fi

	# 硬件不公平队列
	if [ "$smarthqos" -eq "1" ]; then
		# 设置全局上传
		for i in $(seq 1 31); do
			if [ "$upload" -ne "0" ]; then
				echo 2 1 $(($upload*225)) 1 $(($upload*1000)) 4 1 > /sys/kernel/debug/hnat/qdma_txq$i
			fi
		done

		# 设置全局下载
		for i in $(seq 33 63); do
			if [ "$download" -ne "0" ]; then
				echo 3 1 $(($download*200)) 1 $(($download*1000)) 4 1 > /sys/kernel/debug/hnat/qdma_txq$i
			fi
		done

		# 设置特殊队列的限速
		echo 2 1 $(($upload*100)) 1 $(($upload*1000)) 4 1 > /sys/kernel/debug/hnat/qdma_txq30
		echo 3 1 $(($download*150)) 1 $(($download*1000)) 4 1 > /sys/kernel/debug/hnat/qdma_txq62
		echo 2 1 $(($upload*100)) 1 $(($upload*1000)) 4 1 > /sys/kernel/debug/hnat/qdma_txq27
		echo 3 1 $(($download*150)) 1 $(($download*1000)) 4 1 > /sys/kernel/debug/hnat/qdma_txq59

		# IPv4 规则
		logger -t eqos "Setting up IPv4 traffic classification"

		# 小包优先
		iptables -t mangle -A eqos -i br-lan -m length --length :256 -j DSCP --set-dscp 28 -m comment --comment "EQoS_PACKETS_PREFER"
		iptables -t mangle -A eqos -o br-lan -m length --length :256 -j DSCP --set-dscp 60 -m comment --comment "EQoS_PACKETS_PREFER_RELAY"
		
		# 网页浏览数据
		iptables -t mangle -A eqos -i br-lan -p tcp -m multiport --dports 80,443,8080,8081 -j DSCP --set-dscp 29 -m comment --comment "EQoS_HTTP"
		iptables -t mangle -A eqos -o br-lan -p tcp -m multiport --sports 80,443,8080,8081 -j DSCP --set-dscp 61 -m comment --comment "EQoS_HTTP_REPLY"

		# 全局TCP
		iptables -t mangle -A eqos -i br-lan -p tcp -j DSCP --set-dscp 31 -m comment --comment "EQoS_TCP"
		iptables -t mangle -A eqos -o br-lan -p tcp -j DSCP --set-dscp 63 -m comment --comment "EQoS_TCP_RELAY"

		# 全局UDP
		iptables -t mangle -A eqos -i br-lan -p udp -j DSCP --set-dscp 30 -m comment --comment "EQoS_UDP"
		iptables -t mangle -A eqos -o br-lan -p udp -j DSCP --set-dscp 62 -m comment --comment "EQoS_UDP_RELAY"

		# 限制高频发包
		iptables -t mangle -A eqos -i br-lan -p udp \
		-m hashlimit \
		--hashlimit-mode srcip,srcport \
		--hashlimit-name udpout \
		--hashlimit-above 5/sec \
		--hashlimit-burst 5 \
		--hashlimit-htable-expire 10000 \
		--hashlimit-htable-gcinterval 10000 \
		-j DSCP --set-dscp 27

		iptables -t mangle -A eqos -o br-lan -p udp \
		-m hashlimit \
		--hashlimit-mode dstip,dstport \
		--hashlimit-name udpin \
		--hashlimit-above 5/sec \
		--hashlimit-burst 5 \
		--hashlimit-htable-expire 10000 \
		--hashlimit-htable-gcinterval 10000 \
		-j DSCP --set-dscp 59

		# IPv6 规则
		logger -t eqos "Setting up IPv6 traffic classification"

		# 小包优先
		ip6tables -t mangle -A eqos -i br-lan -m length --length :256 -j DSCP --set-dscp 28 -m comment --comment "EQoS_PACKETSV6_PREFER"
		ip6tables -t mangle -A eqos -o br-lan -m length --length :256 -j DSCP --set-dscp 60 -m comment --comment "EQoS_PACKETSV6_PREFER_RELAY"

		# 网页浏览数据
		ip6tables -t mangle -A eqos -i br-lan -p tcp -m multiport --dports 80,443,8080,8081 -j DSCP --set-dscp 29 -m comment --comment "EQoS_HTTPv6"
		ip6tables -t mangle -A eqos -o br-lan -p tcp -m multiport --sports 80,443,8080,8081 -j DSCP --set-dscp 61 -m comment --comment "EQoS_HTTPv6_REPLY"

		# 全局TCP
		ip6tables -t mangle -A eqos -i br-lan -p tcp -j DSCP --set-dscp 31 -m comment --comment "EQoS_TCPV6"
		ip6tables -t mangle -A eqos -o br-lan -p tcp -j DSCP --set-dscp 63 -m comment --comment "EQoS_TCPV6_RELAY"

		# 全局UDP
		ip6tables -t mangle -A eqos -i br-lan -p udp -j DSCP --set-dscp 30 -m comment --comment "EQoS_UDPV6"
		ip6tables -t mangle -A eqos -o br-lan -p udp -j DSCP --set-dscp 62 -m comment --comment "EQoS_UDPV6_RELAY"


		# 限制高频发包
		ip6tables -t mangle -A eqos -i br-lan -p udp \
		-m hashlimit \
		--hashlimit-mode srcip,srcport \
		--hashlimit-name udp6out \
		--hashlimit-above 5/sec \
		--hashlimit-burst 5 \
		--hashlimit-htable-expire 10000 \
		--hashlimit-htable-gcinterval 10000 \
		-j DSCP --set-dscp 27

		ip6tables -t mangle -A eqos -o br-lan -p udp \
		-m hashlimit \
		--hashlimit-mode dstip,dstport \
		--hashlimit-name udp6in \
		--hashlimit-above 5/sec \
		--hashlimit-burst 5 \
		--hashlimit-htable-expire 10000 \
		--hashlimit-htable-gcinterval 10000 \
		-j DSCP --set-dscp 59
	fi

	# 删除旧EQoS相关的PREROUTING规则（通过注释标识）
	# iptables -t mangle -F PREROUTING
    logger -t eqos "Cleaning existing PREROUTING rules"
    iptables-save -t mangle | grep -E 'PREROUTING.*--comment "EQOS_' | while read line; do
        echo "${line//-A/-D}" | iptables-restore
    done 2>/dev/null

	# 多接口负载均衡
	if [ $interface ]; then
		bash /usr/sbin/loadbalance "$interface"
	fi

	# 设备限速
	logger -t eqos "Starting device-specific configuration"
	config_foreach parse_device "device"

	logger -t eqos "Device configuration completed"
}

stop_service() {
	eqos stop
	# 删除所有EQoS添加的PREROUTING规则
	# iptables -t mangle -F PREROUTING
    logger -t eqos "Cleaning existing PREROUTING rules"
    iptables-save -t mangle | grep -E 'PREROUTING.*--comment "EQOS_' | while read line; do
        echo "${line//-A/-D}" | iptables-restore
    done 2>/dev/null
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "eqos"
}
